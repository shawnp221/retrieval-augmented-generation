OPENAI_API_KEY=
COHERE_API_KEY=

# openai | fake  (fake = offline hashing embedder, lets you test steps 3-6 without an API key)
EMBEDDER_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# cohere | bge | overlap  (overlap = offline lexical stand-in)
RERANKER_BACKEND=cohere
COHERE_RERANK_MODEL=rerank-v3.5
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3

LLM_MODEL=gpt-4o-mini

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
ES_URL=http://localhost:9200
ES_INDEX=chunks
ES_SHARDS=1
ES_REPLICAS=0

CHUNK_MAX_TOKENS=500
RETRIEVAL_TOP_K=50
RRF_K=60
FINAL_TOP_K=5
